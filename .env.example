# Local only. scripts/setup.py generates a password without overwriting an existing .env.
POSTGRES_PASSWORD=replace-with-generated-local-password
WEB_PORT=5180
API_PORT=8180
MAX_UPLOAD_MB=256

# Local credentials. Never use VITE_ for secrets. Model/upload defaults are imported
# into PostgreSQL on first bootstrap; edit them in Connections after that.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_BASE_URL=https://litellm.tools.shiphero.com/v1
JEV_API_KEY=
JEV_MODEL=jev-1.14.0
