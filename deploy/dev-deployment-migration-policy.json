{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunParseMigration",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:us-east-1:789248412670:task-definition/parse-migration:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:us-east-1:789248412670:cluster/internal-tooling-dev"
        }
      }
    },
    {
      "Sid": "WaitForAndStopMigrationTasks",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "arn:aws:ecs:us-east-1:789248412670:task/internal-tooling-dev/*"
    }
  ]
}
